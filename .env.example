# Local Postgres (docker compose). Pick your own password; .env is git-ignored.
POSTGRES_USER=tender
POSTGRES_PASSWORD=
POSTGRES_DB=tender_detector
POSTGRES_PORT=5432

# Local: postgresql://tender:<password>@localhost:5432/tender_detector
# Production: the Supabase session pooler connection string, stored only as the
# DATABASE_URL GitHub Actions secret. Set it here only to test a write locally.
DATABASE_URL=

ETENDERS_BASE_URL=https://www.etenders.gov.za
CIPC_API_KEY=
LOG_LEVEL=INFO
